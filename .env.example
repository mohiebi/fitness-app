APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Coach AI assistant (optional). It talks to any OpenAI-compatible endpoint:
# set the key, and the base URL if you use a gateway. Leave the key empty to turn it off.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Default https://api.openai.com/v1. AI_BASE_URL, if set, wins over this.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Use json_object for gateways that don't support structured outputs.
OPENAI_RESPONSE_FORMAT=json_schema
AI_BASE_URL=
AI_DAILY_DRAFTS_PER_COACH=60
# Or use Claude instead: AI_PROVIDER=anthropic, then set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Coach subscriptions (prices in toman)
FITNESSOS_TRIAL_DAYS=14
FITNESSOS_STARTER_PRICE=490000
FITNESSOS_PRO_PRICE=990000

# Telegram bot: payments (card-to-card receipts approved in the admin chat)
# and the coach assistant. Leave TELEGRAM_BOT_TOKEN empty to turn the bot off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# The clock coaches mean when they choose the hour of their morning summary.
TELEGRAM_TIMEZONE=Asia/Tehran
# The bot always speaks this language, whatever the website's is.
TELEGRAM_LOCALE=fa
# Only for a site whose public address differs from APP_URL, or a local test.
TELEGRAM_WEBHOOK_DOMAIN=
# Only to point at another Bot API server (or a test double).
TELEGRAM_API_BASE_URL=https://api.telegram.org/
PAYMENT_CARD_NUMBER=
# Quote values with spaces, e.g. PAYMENT_CARD_HOLDER="Ali Ahmadi"
PAYMENT_CARD_HOLDER=
